# Copy this file to .env and fill in real values. Never commit .env.

# Postgres connection string. Matches docker-compose.yml defaults for local dev.
DATABASE_URL="postgresql://sunleon:sunleon_dev_password@localhost:5432/sunleon_voice"

# Auth.js session encryption secret. Generate with: npx auth secret
AUTH_SECRET=""

# Base URL of the running app.
NEXTAUTH_URL="http://localhost:3000"

# Vercel AI Gateway key. Server-side only — never expose it with a NEXT_PUBLIC_ prefix.
# Used for knowledge-base embeddings (src/server/knowledge/embeddings.ts) and, since Phase 3,
# for minting short-lived real-time voice tokens (src/server/voice/provider.ts).
# Without it: knowledge sources fail at the embedding step and voice sessions refuse to start,
# both with a clear visible error — see docs/KNOWN_LIMITATIONS.md. Get a key at vercel.com.
AI_GATEWAY_API_KEY=""

# Paystack SECRET key (sk_test_... or sk_live_...). Server-side only. Used to start checkouts,
# verify transactions, cancel subscriptions, and to verify webhook signatures (Paystack signs
# webhooks with this same key). Without it: plans can't be bought online, the webhook answers 503,
# and organizations can still be put on a plan manually from /admin/billing. See
# docs/PROVIDER_INTEGRATIONS.md for the Paystack dashboard setup (plans + webhook URL).
PAYSTACK_SECRET_KEY=""

# Shared secret for the stale-session sweeper (/api/cron/sweep-sessions). Vercel Cron sends it as
# "Authorization: Bearer <CRON_SECRET>". Generate with: openssl rand -hex 32
CRON_SECRET=""
