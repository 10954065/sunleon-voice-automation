generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  OWNER
  ADMIN
  AGENT_MANAGER
  ANALYST
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  passwordHash    String?
  name            String?
  // Platform operator flag (cross-tenant admin console). Never settable from the app UI;
  // granted with a direct SQL update — see docs/DEPLOYMENT_RUNBOOK.md.
  isPlatformAdmin Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  accounts    Account[]
  sessions    Session[]
  memberships Membership[]
  auditLogs   AuditLog[]   @relation("AuditLogActor")
}

model Organization {
  id                      String   @id @default(cuid())
  name                    String
  slug                    String   @unique
  // Most the owner allows in overage charges per billing period, in minor units (pesewas).
  // 0 = hard stop at the plan's included minutes.
  overageBudgetMinor      Int      @default(0)
  // Transcripts are stored only when the owner turns this on AND the visitor ticks the consent
  // box for that conversation. Retention is enforced daily by the retention job.
  storeTranscripts        Boolean  @default(false)
  transcriptRetentionDays Int      @default(30)
  leadRetentionDays       Int      @default(365)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  memberships         Membership[]
  auditLogs           AuditLog[]
  agents              Agent[]
  knowledgeSources    KnowledgeSource[]
  conversations       Conversation[]
  leads               Lead[]
  subscription        Subscription?
  usageLedger         UsageLedgerEntry[]
  usageAlerts         UsageAlert[]
  billingTransactions BillingTransaction[]
  transcripts         ConversationTranscript[]
}

model Agent {
  id                  String    @id @default(cuid())
  organizationId      String
  name                String
  archivedAt          DateTime?
  publishedVersionId  String?   @unique
  allowedEmbedDomains String[]  @default([])
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  versions         AgentVersion[]    @relation("AgentVersions")
  publishedVersion AgentVersion?     @relation("PublishedVersion", fields: [publishedVersionId], references: [id])
  knowledgeSources KnowledgeSource[]
  conversations    Conversation[]
  leads            Lead[]

  @@index([organizationId])
}

model AgentVersion {
  id                 String    @id @default(cuid())
  agentId            String
  versionNumber      Int
  instructions       String
  persona            String?
  tone               String?
  greeting           String?
  languages          String[]  @default(["en"])
  leadCaptureEnabled Boolean   @default(false)
  voice              String    @default("alloy")
  createdAt          DateTime  @default(now())
  publishedAt        DateTime?

  agent            Agent          @relation("AgentVersions", fields: [agentId], references: [id], onDelete: Cascade)
  publishedByAgent Agent?         @relation("PublishedVersion")
  conversations    Conversation[]

  @@unique([agentId, versionNumber])
  @@index([agentId])
}

enum ConversationChannel {
  TEST
  EMBED
}

enum ConversationStatus {
  ACTIVE
  COMPLETED
  FAILED
}

// Classified from what actually happened (src/server/conversations/outcome.ts), never guessed.
enum ConversationOutcome {
  // The visitor never connected (no provider token was issued).
  NOT_CONNECTED
  FAILED
  // Connected, but the browser never reported the end; closed by the sweeper.
  ABANDONED
  // Connected for less than SHORT_CONVERSATION_SECONDS.
  SHORT
  ENGAGED
  LEAD_CAPTURED
}

model Conversation {
  id                String               @id @default(cuid())
  organizationId    String
  agentId           String
  agentVersionId    String
  channel           ConversationChannel
  status            ConversationStatus   @default(ACTIVE)
  originDomain      String?
  startedAt         DateTime             @default(now())
  tokenIssuedAt     DateTime?
  // Voice seconds held against the organization's allowance when the session was prepared.
  // Also the session's maximum length, which the widget enforces.
  reservedSeconds   Int                  @default(0)
  endedAt           DateTime?
  closeReason       String?
  errorMessage      String?
  // Snapshot when the session was prepared: the organization stored transcripts and the visitor
  // ticked the consent box. A transcript is accepted only when this is true.
  transcriptConsent Boolean              @default(false)
  // Null while the session is active.
  outcome           ConversationOutcome?

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agent        Agent                   @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentVersion AgentVersion            @relation(fields: [agentVersionId], references: [id], onDelete: Cascade)
  usageEvents  UsageEvent[]
  leads        Lead[]
  transcript   ConversationTranscript?

  @@index([organizationId, agentId])
  @@index([agentId, startedAt])
  @@index([organizationId, startedAt])
}

model ConversationTranscript {
  id             String    @id @default(cuid())
  conversationId String    @unique
  organizationId String
  // [{ role: "user" | "assistant", text }] as reported by the caller's browser when the call ended.
  // Not verified against the provider (there is no server-side relay) — labelled as such in the UI.
  entries        Json
  entryCount     Int
  // AI summary of the entries. Personal data like the transcript, so it is deleted with it.
  summary        String?
  summaryModel   String?
  summarizedAt   DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

enum UsageEventType {
  SESSION_STARTED
  SESSION_ENDED
  TOOL_CALL
  ERROR
}

model UsageEvent {
  id             String         @id @default(cuid())
  organizationId String
  agentId        String
  conversationId String
  type           UsageEventType
  metadata       Json?
  createdAt      DateTime       @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([conversationId])
}

// --- Phase 4: plans, usage ledger, billing ---

model Plan {
  id                        String   @id @default(cuid())
  code                      String   @unique
  name                      String
  // Minor units (pesewas for GHS). Illustrative until provider costs are measured.
  priceMinor                Int
  currency                  String   @default("GHS")
  includedMinutes           Int
  maxConcurrentSessions     Int
  maxAgents                 Int
  // Null = overage never allowed on this plan, whatever the organization's budget.
  overageRateMinorPerMinute Int?
  warningThresholdPercent   Int      @default(80)
  // Trial plans apply automatically for trialDays after an organization is created.
  isTrial                   Boolean  @default(false)
  trialDays                 Int?
  // Shown for self-serve purchase. Custom (enterprise) plans are private and assigned by an admin.
  isPublic                  Boolean  @default(true)
  active                    Boolean  @default(true)
  paystackPlanCode          String?  @unique
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  subscriptions       Subscription[]
  billingTransactions BillingTransaction[]
}

enum SubscriptionStatus {
  ACTIVE
  NON_RENEWING
  PAST_DUE
  CANCELED
}

enum BillingProvider {
  PAYSTACK
  MANUAL
}

model Subscription {
  id                       String             @id @default(cuid())
  organizationId           String             @unique
  planId                   String
  status                   SubscriptionStatus
  provider                 BillingProvider
  // Billing periods are calendar months counted from the anchor. Entitlements apply only while
  // now < paidThroughAt, whatever the status, so a missed renewal lapses on its own.
  billingAnchorAt          DateTime
  paidThroughAt            DateTime
  providerCustomerCode     String?
  providerSubscriptionCode String?            @unique
  // Paystack requires this (with the subscription code) to disable a subscription.
  // It is not a payment credential.
  providerEmailToken       String?
  canceledAt               DateTime?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan         @relation(fields: [planId], references: [id])

  @@index([providerCustomerCode])
}

enum UsageMetric {
  VOICE_SECONDS
}

model UsageLedgerEntry {
  id                  String      @id @default(cuid())
  organizationId      String
  agentId             String?
  conversationId      String?
  metric              UsageMetric
  quantity            Int
  // Attribution time (the session start), which decides the billing period.
  occurredAt          DateTime
  // "server_clock" (measured start to end) or "sweeper_reservation" (abandoned session,
  // charged its full reservation as a conservative estimate).
  source              String
  provider            String?
  model               String?
  // Snapshot of the estimated provider cost in micro-units of the plan currency (1e-6 GHS),
  // using the ProviderCostRate in force when recorded. Null when no rate is configured.
  estimatedCostMicros Int?
  // Unique: a retried end request, beacon or sweep can never record the same usage twice.
  idempotencyKey      String      @unique
  createdAt           DateTime    @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, occurredAt])
}

enum UsageAlertKind {
  THRESHOLD_WARNING
  ALLOWANCE_EXHAUSTED
}

model UsageAlert {
  id               String         @id @default(cuid())
  organizationId   String
  kind             UsageAlertKind
  periodStart      DateTime
  usedSeconds      Int
  allowanceSeconds Int
  createdAt        DateTime       @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // One alert of each kind per billing period.
  @@unique([organizationId, kind, periodStart])
}

model ProviderCostRate {
  id              String      @id @default(cuid())
  metric          UsageMetric
  provider        String
  model           String
  // Estimated provider cost per unit (per voice second) in micro-units of GHS.
  microsPerUnit   Int
  // Where the number came from, e.g. "Gateway invoice Oct 2026" — required, so no rate is unexplained.
  note            String
  updatedByUserId String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([metric, provider, model])
}

enum BillingTransactionStatus {
  PENDING
  SUCCESS
  FAILED
  // Paystack reported success but the amount, currency or plan didn't match ours — not granted.
  REJECTED
}

enum BillingTransactionKind {
  INITIAL
  RENEWAL
}

model BillingTransaction {
  id             String                   @id @default(cuid())
  organizationId String
  planId         String?
  provider       BillingProvider
  kind           BillingTransactionKind
  reference      String                   @unique
  status         BillingTransactionStatus @default(PENDING)
  amountMinor    Int
  currency       String
  customerEmail  String?
  paidAt         DateTime?
  failureReason  String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan?        @relation(fields: [planId], references: [id])

  @@index([organizationId, createdAt])
}

enum WebhookEventStatus {
  PROCESSED
  IGNORED
}

model PaymentWebhookEvent {
  id             String             @id @default(cuid())
  provider       BillingProvider
  // SHA-256 of the raw signed body: an identical redelivery is recognised and skipped.
  eventKey       String
  eventType      String
  status         WebhookEventStatus
  organizationId String?
  // A minimal summary (codes, references, amounts) — never card or authorization details.
  summary        Json?
  note           String?
  receivedAt     DateTime           @default(now())

  @@unique([provider, eventKey])
  @@index([receivedAt])
}

enum LeadStatus {
  NEW
  CONTACTED
  CLOSED
}

model Lead {
  id              String     @id @default(cuid())
  organizationId  String
  agentId         String
  conversationId  String?
  name            String?
  phone           String?
  email           String?
  note            String?
  status          LeadStatus @default(NEW)
  statusChangedAt DateTime?
  createdAt       DateTime   @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agent        Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([organizationId, agentId])
  @@index([organizationId, createdAt])
}

enum KnowledgeSourceType {
  FILE
  URL
  FAQ
  MANUAL
}

enum KnowledgeSourceStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

model KnowledgeSource {
  id             String                @id @default(cuid())
  organizationId String
  agentId        String
  type           KnowledgeSourceType
  status         KnowledgeSourceStatus @default(PENDING)
  title          String
  sourceUrl      String?
  storageKey     String?
  rawContent     String?
  errorMessage   String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agent        Agent            @relation(fields: [agentId], references: [id], onDelete: Cascade)
  chunks       KnowledgeChunk[]

  @@index([organizationId])
  @@index([agentId])
}

model KnowledgeChunk {
  id             String   @id @default(cuid())
  sourceId       String
  organizationId String
  agentId        String
  chunkIndex     Int
  content        String
  createdAt      DateTime @default(now())

  source KnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  // Declared `Unsupported` (not a real Prisma-managed field) so `prisma migrate dev`'s
  // drift detection knows this column exists and never proposes dropping it. The column
  // itself was added by a raw-SQL migration (classic generator has no native vector type)
  // and is read/written only via $queryRaw/$executeRaw. See docs/DATABASE_DESIGN.md.
  embedding Unsupported("vector(1536)")?

  @@unique([sourceId, chunkIndex])
  @@index([organizationId, agentId])
}

model Membership {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  role           Role
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  actorUserId    String?
  action         String
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?         @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([createdAt])
}

// --- Phase 5: monitoring ---

// Server errors grouped by fingerprint (source + route + normalised message). Messages and stacks
// are scrubbed of emails, phone numbers and secrets before they are stored.
model ErrorReport {
  id          String   @id @default(cuid())
  fingerprint String   @unique
  // "render" | "route" | "action" | "proxy" | "job" | "server"
  source      String
  route       String?
  message     String
  stack       String?
  digest      String?
  occurrences Int      @default(1)
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@index([lastSeenAt])
}

enum JobRunStatus {
  SUCCEEDED
  FAILED
}

model JobRun {
  id         String       @id @default(cuid())
  job        String
  status     JobRunStatus
  startedAt  DateTime
  finishedAt DateTime
  details    Json?
  error      String?

  @@index([job, startedAt])
}

// --- Auth.js (NextAuth) required models ---

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
